# When .npmignore exists, npm ignores .gitignore for packing.
# Keep packaging exclusions here even if they already appear in .gitignore.

**/__pycache__/**
**/*.py[cod]
**/*$py.class
**/.pytest_cache/**
**/.venv/**
**/venv/**

.env
.env.*
*.pem
*.key
*.p12
*.pfx
*token*
*credentials*

.open-kimi-ppt/
browser-profile/
playwright-report/
test-results/
*.crdownload

.qa-images/
*.pptx
*.ppt
*.pdf
*.pptd.bak
export-output/
downloads/

*.log
logs/
tmp/
temp/

.vscode/
.idea/
.DS_Store
Thumbs.db
_user_meta.json

*.tgz
*.zip
